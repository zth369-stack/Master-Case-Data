# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# MyGDX (Malaysian Government Central Data Exchange) Credentials
# -------------------------------------------------------------
# MYGDX_GATEWAY_URL: Base URL for MyGDX API Gateway
# Production: https://api.mygdx.gov.my
# Sandbox: https://sandbox.mygdx.gov.my
MYGDX_GATEWAY_URL="https://sandbox.mygdx.gov.my"

# MYGDX_CONSUMER_KEY: Agency consumer key / Client ID assigned by MAMPU/MyGDX
MYGDX_CONSUMER_KEY=""

# MYGDX_CONSUMER_SECRET: Secret token for agency authentication
MYGDX_CONSUMER_SECRET=""

# MYGDX_AGENCY_CODE: Registered Agency or GLC identifier code (e.g., LHDN, KWSP, MIDA, GLC_01)
MYGDX_AGENCY_CODE="AGENCY_DEMO_01"

# MYGDX_ENVIRONMENT: Deployment environment ('sandbox' | 'staging' | 'production')
MYGDX_ENVIRONMENT="sandbox"

# -------------------------------------------------------------
# SSM (Suruhanjaya Syarikat Malaysia) Restricted Endpoints
# -------------------------------------------------------------
# SSM_API_BASE_URL: SSM endpoint base path within MyGDX or direct gateway
SSM_API_BASE_URL="https://sandbox.mygdx.gov.my/ssm/v1"

# SSM_USER_ID: Authorized agency user/member ID approved by SSM
SSM_USER_ID=""

# SSM_SECRET_TOKEN: Service authentication token for SSM restricted query calls
SSM_SECRET_TOKEN=""

# SSM_SIGNING_SECRET: Secret key used to compute HMAC-SHA256 request headers
SSM_SIGNING_SECRET=""

# SSM_REQUEST_TIMEOUT_MS: HTTP client request timeout in milliseconds
SSM_REQUEST_TIMEOUT_MS="10000"

# SSM_RESTRICTED_ENDPOINTS: Comma-delimited list of restricted SSM status endpoints allowed
SSM_RESTRICTED_ENDPOINTS="roc_status,rob_status,llp_status,compliance_status"

# -------------------------------------------------------------
# Security & Compliance Flags
# -------------------------------------------------------------
# MIDDLEWARE_ENFORCE_HTTPS: Strictly require TLS/HTTPS for all external calls
MIDDLEWARE_ENFORCE_HTTPS="true"

# MIDDLEWARE_AUDIT_LOG_ENABLED: Enable audit logging for all government data queries
MIDDLEWARE_AUDIT_LOG_ENABLED="true"

# -------------------------------------------------------------
# Real Enterprise B2B Document Extraction & CTC Gateways
# -------------------------------------------------------------
# MYDATA-SSM B2B Enterprise API (Big Dataworks Sdn Bhd - Authorized SSM Distributor)
# Portal: https://api.mydata-ssm.com.my/v2
MYDATA_SSM_API_BASE_URL="https://api.mydata-ssm.com.my/v2"
MYDATA_SSM_MEMBER_CODE=""
MYDATA_SSM_API_KEY=""
MYDATA_SSM_SECRET_TOKEN=""

# SSM e-Info B2B Direct Gateway (Commerce Dot Com Sdn Bhd)
# Portal: https://www.ssm-e-info.com.my
SSM_EINFO_API_URL="https://b2b.ssm-e-info.com.my/api/v1"
SSM_EINFO_ACCOUNT_ID=""
SSM_EINFO_HMAC_SECRET=""

# e-Kehakiman EFS API (Court Case Files & Sealed Cause Papers)
# Mahkamah Persekutuan Malaysia / Omesti EFS Gateway
EFS_KEHAKIMAN_PORTAL_URL="https://efiling.kehakiman.gov.my/api/v2"
EFS_FIRM_REGISTRATION_NO=""
EFS_BAR_COUNCIL_TOKEN_SERIAL=""

# LHDN STAMPS Digital Certificate Verification
# Lembaga Hasil Dalam Negeri Malaysia
LHDN_STAMPS_VERIFY_URL="https://stamps.hasil.gov.my/stamps/verifyCertificate"
LHDN_STAMPS_API_TOKEN=""

# JPN MyIdentity / MyGDX Restricted GovNet Bridge
# Jabatan Pendaftaran Negara / MAMPU
JPN_MYIDENTITY_BRIDGE_URL="https://mygdx.malaysia.gov.my/jpn/v1"
JPN_AGENCY_MOU_REFERENCE=""

